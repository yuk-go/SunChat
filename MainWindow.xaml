<Window x:Class="SunChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SunChat — LAN 메신저" Height="520" Width="760"
        Icon="sun.ico"
        FontFamily="Malgun Gothic" FontSize="13">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- top: my info + settings -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="SettingsBtn" Content="환경설정" DockPanel.Dock="Right"
                    Width="80" Margin="6,0,0,0" Click="SettingsBtn_Click"/>
            <TextBlock x:Name="InfoLabel" VerticalAlignment="Center" FontWeight="Bold"/>
        </DockPanel>

        <!-- middle: peers | chat -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="접속자" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4"/>
                <CheckBox x:Name="SameGroupOnly" DockPanel.Dock="Top" Content="같은 그룹만 보기"
                          Margin="0,0,0,4" Checked="SameGroupOnly_Changed" Unchecked="SameGroupOnly_Changed"/>
                <Button x:Name="ConnectBtn" DockPanel.Dock="Top" Content="IP로 연결"
                        Margin="0,0,0,4" Click="ConnectBtn_Click"/>
                <Button x:Name="RefreshBtn" DockPanel.Dock="Top" Content="새로고침"
                        Margin="0,0,0,4" Click="RefreshBtn_Click"/>
                <ListBox x:Name="PeerList" DisplayMemberPath="Display"
                         SelectionChanged="PeerList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Online}" Value="False">
                                    <Setter Property="Foreground" Value="Gray"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                               Foreground="#555" Margin="0,4,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>

            <TextBox x:Name="ChatBox" Grid.Column="1" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="#FAFAFA"/>
        </Grid>

        <!-- input -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="FileBtn" Content="파일 보내기" DockPanel.Dock="Right"
                    Width="100" Margin="6,0,0,0" Click="FileBtn_Click"/>
            <Button x:Name="SendBtn" Content="보내기" DockPanel.Dock="Right"
                    Width="80" Click="SendBtn_Click"/>
            <TextBox x:Name="InputBox" VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown"/>
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,6,0,0"
                   Foreground="Gray" Text="시작하는 중..."/>
    </Grid>
</Window>
