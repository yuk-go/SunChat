<Window x:Class="SunChat.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Topmost="True" SizeToContent="Manual" Width="300" Height="84"
        FontFamily="Malgun Gothic">
    <Border Background="#2B2B2B" CornerRadius="10" Margin="8"
            MouseLeftButtonUp="Border_Click" Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Grid.Row="0" Foreground="#FFD666"
                       FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="BodyText" Grid.Row="1" Foreground="White" FontSize="12"
                       Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="40"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</Window>
